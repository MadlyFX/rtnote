{
  "expo": {
    "name": "RTNote",
    "slug": "rtnote",
    "scheme": "rtnote",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.madlyfx.rtnote",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIRequiresFullScreen": true,
        "NSMicrophoneUsageDescription": "Allow RTNote to use the microphone to record voice memos into your notes.",
        "NSCameraUsageDescription": "Allow RTNote to use your camera to take photos and insert them into your notes."
      }
    },
    "android": {
      "package": "com.madlyfx.rtnote",
      "versionCode": 261,
      "adaptiveIcon": {
        "backgroundColor": "#EFE4CF",
        "backgroundImage": "./assets/icon.png",
        "foregroundImage": "./assets/adaptive-icon-transparent.png"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow RTNote to take photos and insert them into your notes.",
          "microphonePermission": "Allow RTNote to use the microphone to record voice memos into your notes.",
          "photosPermission": "Allow RTNote to choose photos to insert into your notes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EFE4CF",
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "usesCleartextTraffic": true,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": false
          },
          "android": {
            "enabled": true,
            "multipleShareMimeTypes": [
              "text/plain",
              "image/*"
            ],
            "singleShareMimeTypes": [
              "text/plain",
              "image/*"
            ]
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow RTNote to use the microphone to record voice memos into your notes.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
