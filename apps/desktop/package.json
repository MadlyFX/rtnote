{
  "name": "@rtnote/desktop",
  "version": "2.23.0",
  "desktopName": "RTNote",
  "private": true,
  "description": "Native RTNote desktop client",
  "author": "RTNote contributors",
  "type": "module",
  "main": "src/main/index.mjs",
  "scripts": {
    "dev": "bun scripts/build-backup-worker.mjs && electron .",
    "start": "bun scripts/build-backup-worker.mjs && electron .",
    "dist": "electron-builder --config electron-builder.yml",
    "verify-origin-migration": "electron ../../scripts/renderer-origin-verifier",
    "dist:fork": "electron-builder --config electron-builder.fork.yml"
  },
  "devDependencies": {
    "electron": "44.10.2",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "@rtnote/public-network": "workspace:*",
    "croner": "^10.0.1",
    "electron-updater": "^6.6.2",
    "fflate": "0.8.3",
    "webdav": "^5.10.0",
    "zod": "4.6.6"
  }
}
